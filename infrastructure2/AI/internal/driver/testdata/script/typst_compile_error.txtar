# Chạy binary typst thật trên file lỗi cú pháp để xác minh exit code != 0 và định dạng stderr thật

! exec typst compile --input teacher=true broken.typ out.pdf
stderr 'broken\.typ:5:'
stderr 'unknown variable'
! exists out.pdf

-- broken.typ --
#let x = 1
